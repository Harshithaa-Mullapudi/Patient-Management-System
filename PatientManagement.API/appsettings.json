{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=PatientManagementDB;Username=postgres;Password=YOUR_PASSWORD"
  },
  "PatientSettings": {
    "MaxPatientsToReturn": 50,
    "ApplicationName": "PatientManagementAPI",
    "EnablePatientRegistration": true
  },
  "Jwt": {
    "Key": "CHANGE_THIS_DEVELOPMENT_KEY_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES",
    "Issuer": "PatientManagementAPI",
    "Audience": "PatientManagementClient",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
